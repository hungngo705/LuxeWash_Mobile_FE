{
  "expo": {
    "name": "LuxeWash",
    "slug": "luxewash",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "luxewashmobilefe",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1A37"
    },
    "ios": {
      "bundleIdentifier": "com.luxewash.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Cho phép LuxeWash truy cập vị trí của bạn để tìm chi nhánh gần nhất."
      }
    },
    "android": {
      "package": "com.luxewash.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0B1A37",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#0B1A37",
          "defaultChannel": "overload-alerts"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1A37",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200,
            "backgroundColor": "#0B1A37"
          },
          "ios": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200,
            "backgroundColor": "#0B1A37"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Cho phép LuxeWash truy cập vị trí của bạn để tìm chi nhánh gần nhất."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LuxeWash cần quyền truy cập ảnh để bạn có thể tải lên hình ảnh xe."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9fbb6bf9-51c4-49c1-a81d-3856d9739042"
      },
      "router": {}
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "hungngo705"
  }
}
